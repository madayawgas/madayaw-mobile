# ==============================================================================
# MADAYAWGAS MOBILE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust variables as needed.
# NOTE: In Expo, all client-accessible environment variables MUST be prefixed
# with EXPO_PUBLIC_ and accessed statically (process.env.EXPO_PUBLIC_VAR).

# Backend Base API URL
# Default desktop localhost / emulator:
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Physical mobile phone testing on the same Wi-Fi LAN:
# Replace 192.168.1.X with your host computer's local IP address:
# EXPO_PUBLIC_API_URL=http://192.168.1.15:5000/api

# Cloud / Staging backend:
# EXPO_PUBLIC_API_URL=https://madayawgas-staging.onrender.com/api

# HTTP Request Timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Store-and-Forward Polling Heartbeat Interval in milliseconds (30 seconds)
EXPO_PUBLIC_SYNC_INTERVAL_MS=30000

# Application Environment ('development' | 'staging' | 'production')
EXPO_PUBLIC_APP_ENV=development

# Operational Route Zone ID (Bunawan Refilling Yard primary dispatch route)
EXPO_PUBLIC_DEFAULT_ZONE_ID=7b8f9e6a-5432-41a9-83bc-9d0e12345678
